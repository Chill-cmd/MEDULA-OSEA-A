# Copia este archivo como .env.local y rellena con las llaves de TU proyecto de Supabase.
# Dashboard de Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Solo para rutas de servidor (API routes), NUNCA exponer al cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_SECRETA
